<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Version>1.0.11-beta</Version>
    <Title>Ariadne</Title>
    <Description>Ariadne is the front-end counterpart to the inverse form finding tool Theseus.</Description>
<TargetExt>.gha</TargetExt>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
  </PropertyGroup>

  <!-- Copy native theseus library to output (Windows, Mac) -->
  <ItemGroup>
    <None Include="Theseus\theseus.dll" Link="theseus.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Theseus\libtheseus.dylib" Link="libtheseus.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Theseus\libtheseus.dylib')" />
    <None Update="LICENSE.txt" Link="Ariadne-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="crates\lbfgsb\LICENSE" Link="ariadne-lbfgsb-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="crates\lbfgsb\UPSTREAM_LICENSE.txt" Link="ariadne-lbfgsb-UPSTREAM_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="crates\lbfgsb\THIRD_PARTY_NOTICES.md" Link="ariadne-lbfgsb-THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Theseus\NATIVE_ARTIFACTS.md" Link="NATIVE_ARTIFACTS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.8" IncludeAssets="compile;build" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.8">
      <IncludeAssets>compile;build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.8" />
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Ariadne.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ariadne.Tests" />
  </ItemGroup>

</Project>
